<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E2124">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/gearButton"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="52dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="&#127925; Audio Manager"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold"
                android:fontFamily="cursive"
                android:layout_marginBottom="44dp"
                android:longClickable="true" />

            <TextView android:id="@+id/labelAlarm"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#9E9E9E" android:textSize="15sp"
                android:layout_marginBottom="6dp"/>
            <SeekBar android:id="@+id/seekAlarm"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:progressTint="#4DD0C4" android:thumbTint="#4DD0C4"
                android:layout_marginBottom="28dp"/>

            <TextView android:id="@+id/labelMusic"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#9E9E9E" android:textSize="15sp"
                android:layout_marginBottom="6dp"/>
            <SeekBar android:id="@+id/seekMusic"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:progressTint="#4DD0C4" android:thumbTint="#4DD0C4"
                android:layout_marginBottom="28dp"/>

            <TextView android:id="@+id/labelNotification"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#9E9E9E" android:textSize="15sp"
                android:layout_marginBottom="6dp"/>
            <SeekBar android:id="@+id/seekNotification"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:progressTint="#4DD0C4" android:thumbTint="#4DD0C4"
                android:layout_marginBottom="28dp"/>

            <TextView android:id="@+id/labelRinger"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#9E9E9E" android:textSize="15sp"
                android:layout_marginBottom="6dp"/>
            <SeekBar android:id="@+id/seekRinger"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:progressTint="#4DD0C4" android:thumbTint="#4DD0C4"
                android:layout_marginBottom="28dp"/>

            <TextView android:id="@+id/labelSystem"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#9E9E9E" android:textSize="15sp"
                android:layout_marginBottom="6dp"/>
            <SeekBar android:id="@+id/seekSystem"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:progressTint="#4DD0C4" android:thumbTint="#4DD0C4"
                android:layout_marginBottom="28dp"/>

            <TextView android:id="@+id/labelVoice"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#9E9E9E" android:textSize="15sp"
                android:layout_marginBottom="6dp"/>
            <SeekBar android:id="@+id/seekVoice"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:progressTint="#4DD0C4" android:thumbTint="#4DD0C4"
                android:layout_marginBottom="16dp"/>

        </LinearLayout>
    </ScrollView>

    <ImageButton
        android:id="@+id/gearButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="20dp"
        android:background="@drawable/circle_button_bg"
        android:src="@android:drawable/ic_menu_manage"
        android:tint="#FFFFFF"
        android:padding="12dp"
        android:contentDescription="Settings" />

</RelativeLayout>
